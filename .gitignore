# ── Python ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# ── Virtual environment ────────────────────────────────────────────────
.venv/
venv/
env/

# ── Jupyter / IPython ─────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints/

# ── Testing ───────────────────────────────────────────────────────────
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# ── OS / IDE ──────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/

# ── Data (keep raw processed only; do NOT commit raw patient data) ────
data/raw/
data/processed/

# ── Models (fitted artefacts are large; version via DVC or git-lfs) ──
models/*.joblib
models/*.pkl

# ── Reports (generated by the pipeline; do not commit) ───────────────
reports/figures/*.png
reports/*.csv

# ── GitHub Pages site (generated notebook HTML; keep the index landing) ─
site/01_eda.html
site/02_modeling.html
site/03_tuned_pipeline.html
